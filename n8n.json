{
  "name": "Machining Agent - Basic Integration",
  "nodes": [
    {
      "parameters": {
        "path": "machining-agent/inbound",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "Webhook_1",
      "name": "Webhook In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "machining-agent-inbound"
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "session_id",
              "value": "={{$json.body.session_id || ('n8n-' + Date.now())}}"
            },
            {
              "name": "user_id",
              "value": "={{$json.body.user_id || 'ce0e837a-fe28-47ae-9ba0-8841fe042ca8'}}"
            },
            {
              "name": "canal_id",
              "value": "={{$json.body.canal_id || '144b1c01-b75c-410b-8a07-54229fa46bd8'}}"
            },
            {
              "name": "message",
              "value": "={{$json.body.message || 'Hola desde n8n'}}"
            }
          ],
          "boolean": [
            {
              "name": "generate_audio",
              "value": false
            }
          ]
        }
      },
      "id": "Set_1",
      "name": "Build Agent Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://172.16.10.167:8000/api/v1/agent/dialogue",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"session_id\": $json.session_id, \"user_id\": $json.user_id, \"canal_id\": $json.canal_id, \"message\": $json.message, \"generate_audio\": $json.generate_audio}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "HTTP_1",
      "name": "Call Machining Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.agent_response}}",
              "operation": "isEmpty"
            }
          ]
        }
      },
      "id": "IF_1",
      "name": "Has Agent Response?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1020,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": true, \"agent\": $json}",
        "options": {}
      },
      "id": "Respond_OK",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1280,
        220
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": false, \"error\": \"No se recibió agent_response\", \"raw\": $json}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "Respond_Error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1280,
        380
      ]
    }
  ],
  "connections": {
    "Webhook In": {
      "main": [
        [
          {
            "node": "Build Agent Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Agent Payload": {
      "main": [
        [
          {
            "node": "Call Machining Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Machining Agent": {
      "main": [
        [
          {
            "node": "Has Agent Response?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Agent Response?": {
      "main": [
        [
          {
            "node": "Respond Error",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1"
}