    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst operation = String(input.operation ?? 'ask').trim().toLowerCase();\nconst allowed = new Set(['ask', 'teach', 'health']);\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nconst errors = [];\n\nif (!allowed.has(operation)) errors.push('operation debe ser ask, teach o health.');\n\nconst instanceCode = String(input.instanceCode ?? '').trim();\nconst agentResourceId = String(input.agentResourceId ?? '').trim();\nconst workRoomId = String(input.workRoomId ?? '').trim();\nconst senderResourceId = String(input.senderResourceId ?? '').trim();\nconst sessionId = String(input.sessionId ?? '').trim();\n\nif (operation === 'ask' || operation === 'teach') {\n  if (!uuid.test(agentResourceId)) errors.push('agentResourceId debe ser un UUID válido.');\n}\nif (operation === 'ask') {\n  if (!uuid.test(workRoomId)) errors.push('workRoomId debe ser un UUID válido.');\n  if (!String(input.message ?? '').trim()) errors.push('message es obligatorio.');\n  if (String(input.message ?? '').length > 5000) errors.push('message no puede superar 5000 caracteres.');\n  if (senderResourceId && !uuid.test(senderResourceId)) errors.push('senderResourceId debe ser un UUID válido.');\n  if (sessionId && !uuid.test(sessionId)) errors.push('sessionId debe ser un UUID válido.');\n  if (input.sendToSolidSET === true && !instanceCode) errors.push('instanceCode es obligatorio si sendToSolidSET=true.');\n}\nif (operation === 'teach') {\n  if (!String(input.knowledge ?? '').trim()) errors.push('knowledge es obligatorio.');\n  if (String(input.knowledge ?? '').length > 50000) errors.push('knowledge no puede superar 50000 caracteres.');\n  if (workRoomId && !uuid.test(workRoomId)) errors.push('workRoomId debe ser un UUID válido.');\n}\n\nlet requestBody = {};\nif (operation === 'ask') {\n  requestBody = {\n    IDWorkRoom: workRoomId,\n    RawMessage: String(input.message).trim(),\n    SelectedAgentResourceIds: [agentResourceId],\n    SendToSolidSET: input.sendToSolidSET === true\n  };\n  if (sessionId) requestBody.IDSession = sessionId;\n  if (senderResourceId) requestBody.SenderResourceId = senderResourceId;\n  if (instanceCode) requestBody.SolidSETInstanceCode = instanceCode;\n}\nif (operation === 'teach') {\n  requestBody = {\n    KnowledgeText: String(input.knowledge).trim(),\n    Source: String(input.source ?? 'n8n').trim() || 'n8n',\n    active: input.active !== false\n  };\n  if (workRoomId) requestBody.IDWorkRoom = workRoomId;\n  if (String(input.title ?? '').trim()) requestBody.Title = String(input.title).trim();\n}\n\nreturn [{ json: {\n  valid: errors.length === 0,\n  operation,\n  errors,\n  agentResourceId,\n  requestBody\n} }];"
      },
