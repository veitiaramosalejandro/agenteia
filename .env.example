# .env - Configuración para desarrollo local

# Entorno de ejecución del servicio: development | production
ENVIRONMENT=production

# Intervalo entre ciclos de aprendizaje desde BD (segundos); 0 desactiva el ciclo.
DB_STUDY_INTERVAL_SECONDS=0
# Reintento de verificación cuando hay actividad y se difiere la ingesta (segundos)
DB_STUDY_IDLE_CHECK_SECONDS=180
# Tiempo máximo permitido por ciclo de estudio de BD (segundos)
DB_STUDY_MAX_RUN_SECONDS=300
# ============================================================
# OLLAMA (Modelos LLM)
# ============================================================
LLM_PROVIDER=ollama
LLM_BASE_URL=
LLM_API_KEY=
# OpenAI API empresarial. OPENAI_API_KEY debe inyectarse como secreto y nunca
# guardarse en Git. LLM_API_KEY conserva compatibilidad con otros proveedores.
OPENAI_API_KEY=
NVIDIA_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_USE_RESPONSES_API=true
OPENAI_STORE_RESPONSES=false
OPENAI_MAX_RETRIES=2
OPENAI_SERVICE_TIER=auto
LLM_TEMPERATURE=0.5
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# Runtimes separados de chat y embeddings, acelerados por GPU en desarrollo.
# EMBEDDING_BASE_URL es obligatoria: su ausencia o un valor vacío impide el arranque.
# Nunca se utiliza OLLAMA_BASE_URL como fallback para embeddings.
OLLAMA_BASE_URL=http://ollama-chat:11434
EMBEDDING_BASE_URL=http://ollama-embeddings:11434
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=32
OLLAMA_CHAT_CONTEXT_LENGTH=4096
OLLAMA_EMBEDDING_CONTEXT_LENGTH=2048
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_CHAT_KEEP_ALIVE=24h
OLLAMA_EMBEDDING_NUM_PARALLEL=2
OLLAMA_EMBEDDING_MAX_QUEUE=64
OLLAMA_EMBEDDING_KEEP_ALIVE=24h
OLLAMA_EMBEDDING_CPUS=2.0
OLLAMA_EMBEDDING_MEMORY_LIMIT=3g
LLM_MAX_OUTPUT_TOKENS=1024
LLM_COMPACT_RUNTIME_PROMPT=true
LLM_DIALOGUE_MAX_OUTPUT_TOKENS=512
LLM_SUGGESTION_MAX_OUTPUT_TOKENS=256
# Máximo efectivo de historial: 3 mensajes. Ollama limita num_predict a 400.
LLM_MAX_HISTORY_MESSAGES=3
LLM_MAX_TOOL_ITERATIONS=2
# Modelo de chat principal del agente
MODEL_NAME=qwen2.5:3b
# Modelo de embeddings para RAG/recuperación semántica
EMBEDDING_MODEL_NAME=nomic-embed-text

# ============================================================
# QDRANT (Base de datos vectorial)
# ============================================================
# URL alternativa de Qdrant en red local
#VECTOR_DB_URL=http://192.168.1.76:6333
# URL activa de Qdrant
VECTOR_DB_URL=http://vector-db:6333
# Colección vectorial donde se indexa conocimiento
VECTOR_COLLECTION_NAME=machining_docs
BUSINESS_RAG_MIN_SCORE=0.60

# ============================================================
# REDIS (Memoria caché y estado)
# ============================================================
# URL alternativa de Redis en red local
#REDIS_URL=redis://192.168.1.76:6379
# URL activa de Redis para historial/caché
REDIS_URL=redis://redis-cache:6379
# Redis de producción: reserva margen para persistencia y overhead del proceso.
REDIS_MEMORY_LIMIT=8g
REDIS_MAXMEMORY=6gb
REDIS_MAXMEMORY_POLICY=allkeys-lru
# Historial conversacional (el conocimiento persistente no usa este TTL).
REDIS_HISTORY_TTL_SECONDS=604800
REDIS_HISTORY_MAX_MESSAGES=100
REDIS_MAINTENANCE_INTERVAL_SECONDS=300
SOLIDSET_RETRY_QUEUE_MAXLEN=10000

# Búsqueda web y aprendizaje persistente en Qdrant
WEB_SEARCH_ENABLED=true
EXTERNAL_SEARCH_PROVIDER=openai
OPENAI_SEARCH_MODEL=gpt-4.1-mini
OPENAI_SEARCH_CONTEXT_SIZE=low
OPENAI_SEARCH_MAX_OUTPUT_TOKENS=400
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_TIMEOUT_SECONDS=12
WEB_SEARCH_REGION=wt-wt
WEB_SEARCH_SAFESEARCH=moderate
WEB_SEARCH_AUTO_LEARN=true

# ============================================================
# POSTGRESQL / SQL SERVER
# ============================================================
# Si usas TimescaleDB/PostgreSQL (el de tu docker-compose)
# Host alternativo de Postgres en red local
#POSTGRES_HOST=192.168.1.76
# Host activo de Postgres/Timescale
POSTGRES_HOST=timescaledb
# Puerto de Postgres/Timescale
POSTGRES_PORT=5432
# Usuario de Postgres/Timescale
POSTGRES_USER=user
# Contraseña de Postgres/Timescale
POSTGRES_PASSWORD=pass
# Base de datos Postgres/Timescale
POSTGRES_DB=machining_db
# Cadena completa de conexión para DB_URL
DB_URL=postgresql://user:pass@timescaledb:5432/machining_db

# Los destinos SQL Server se almacenan por instancia en PostgreSQL.
DB_INGEST_CONNECT_TIMEOUT_SECONDS=15
DB_INGEST_QUERY_TIMEOUT_SECONDS=120

# ============================================================
# DIALOGUE PERFORMANCE (latencia y throughput)
# ============================================================
# Número máximo de conversaciones simultáneas
DIALOGUE_MAX_CONCURRENT=1
# Tiempo máximo de espera para obtener un slot de atención (segundos)
DIALOGUE_ADMISSION_TIMEOUT_SECONDS=5
EMBEDDING_CACHE_ENABLED=true
INTERACTIVE_PRIORITY_ENABLED=true
INGESTION_PAUSE_DURING_INTERACTIVE=true
INGESTION_INTERACTIVE_IDLE_SECONDS=30
INGESTION_INTERACTIVE_POLL_SECONDS=0.25
# 0 mantiene modo bloqueante (respuesta real) y se protege con timeout duro.
# Timeout principal de procesamiento por diálogo (segundos)
DIALOGUE_PROCESSING_TIMEOUT_SECONDS=0
# Timeout duro de seguridad por diálogo cuando el principal está en 0
DIALOGUE_HARD_TIMEOUT_SECONDS=900
# Gracia para liberar recursos después de timeout (segundos)
DIALOGUE_TIMEOUT_RELEASE_GRACE_SECONDS=45
# Activa caché de respuestas duplicadas recientes
DIALOGUE_DUPLICATE_CACHE_ENABLED=true
# TTL de la caché de duplicados (segundos)
DIALOGUE_DUPLICATE_CACHE_TTL_SECONDS=15
# Tamaño máximo de la caché de duplicados
DIALOGUE_DUPLICATE_CACHE_MAX_ITEMS=400
# Umbral para loggear conversaciones lentas (segundos)
DIALOGUE_SLOW_LOG_SECONDS=8
DIALOGUE_REDIS_CACHE_PREFIX=machining:dialogue:v1

# ============================================================
# SOLIDSET COMMUNICATOR (Notification + Chat/Rest controllers)
# ============================================================
# Habilita el listener de Notification API
NOTIF_API_ENABLED=true
# Mantener activado en background para que aprenda continuamente de canales y chat.
NOTIF_API_BACKGROUND_ENABLED=false
# URL base del servicio de notificaciones de SOLIDSET
NOTIF_API_BASE_URL=http://localhost:52131
# Clave de acceso para Notification API (reemplazar en entorno real)
NOTIF_API_ACCESS_KEY=your_access_key_here
# Frecuencia de polling de notificaciones (segundos)
NOTIF_API_POLL_SECONDS=15
# Retraso inicial antes de arrancar el listener (segundos)
NOTIF_API_START_DELAY_SECONDS=5
# Timeout HTTP por request de notificación (segundos)
NOTIF_API_TIMEOUT_SECONDS=15
# Verificación TLS (false permite certificados self-signed)
NOTIF_API_VERIFY_TLS=false
# Habilita logs detallados de auditoría de llamadas API
NOTIF_AUDIT_LOG_ENABLED=false
# Habilita trazas de mensajes capturados
NOTIF_MESSAGE_TRACE_ENABLED=true
# Longitud máxima de mensaje en trazas
NOTIF_MESSAGE_TRACE_MAX_LEN=220
# Pausa el listener cuando hay diálogo activo para priorizar latencia
NOTIF_PAUSE_DURING_DIALOGUE=true

# Endpoint base de ChatController
SOLIDSET_CHAT_BASE_URL=http://localhost:52130
# Endpoint base de RestApiController
SOLIDSET_RESTAPI_BASE_URL=http://localhost:52130

# Usuario de autenticación del agente en SOLIDSET
SOLIDSET_LOGIN_USERNAME=
# Contraseña de autenticación del agente en SOLIDSET
SOLIDSET_LOGIN_PASSWORD=
# Hash alternativo de contraseña (si aplica en la instalación)
SOLIDSET_LOGIN_HASHPASS=
# Resource ID opcional para login contextual (UUID)
SOLIDSET_LOGIN_RESOURCE_ID=
SOLIDSET_RESOURCE_ID=
# Timezone enviada en login legacy
SOLIDSET_TIMEZONE_ID=GMT Standard Time
# ID lógico del workstation/cliente
SOLIDSET_WORKSTATION_ID=1
# Nombre lógico del workstation/cliente
SOLIDSET_WORKSTATION_NAME=Android.1
# Versión de cliente informada a SOLIDSET
SOLIDSET_CLIENT_VERSION=Android.20.0.0
# ID de aplicación SOLIDSET
SOLIDSET_APPLICATION_ID=C9F19A23-36C2-430C-B939-CB495F975D36
# Permite operaciones de escritura reales (send/update)
SOLIDSET_USER_ACTIONS_ENABLED=true

# Activa escucha de mensajes de chat/canal
SOLIDSET_LISTEN_CHAT_MESSAGES=true
# Máximo de canales a revisar por ciclo de escucha
SOLIDSET_CHAT_MAX_CHANNELS=0
# Tamaño de página de mensajes por consulta de canal
SOLIDSET_CHAT_PAGE_SIZE=20

# Activa auto-respuesta en canales/chats capturados
SOLIDSET_AUTO_REPLY_ENABLED=true
# Si true, solo responde cuando detecta token de mención
SOLIDSET_AUTO_REPLY_REQUIRE_MENTION=true
# Token de mención para disparar auto-respuesta
SOLIDSET_AUTO_REPLY_MENTION_TOKEN=@agente
# Si true, también permite responder a mensajes propios (riesgo de loop)
SOLIDSET_AUTO_REPLY_ALLOW_SELF=false
# Máximo de respuestas automáticas por ciclo
SOLIDSET_AUTO_REPLY_MAX_PER_CYCLE=1
# Tamaño máximo del input procesado para auto-respuesta
SOLIDSET_AUTO_REPLY_MAX_INPUT_CHARS=700
SOLIDSET_AUTO_REPLY_FOLLOWUP_TTL_SECONDS=300
CHANNEL_SUMMARY_DEFAULT_MESSAGE_LIMIT=10
CHANNEL_SUMMARY_MAX_MESSAGE_LIMIT=50

# ============================================================
# AUDIO
# ============================================================
# Carpeta de entrada/salida de audio
AUDIO_DIR=./audio_samples
# Intervalo de ingesta de audio/documentos (segundos)
INGEST_INTERVAL_SECONDS=3600
AGENT_TEMPORAL_STATE_TTL_SECONDS=3600
AGENT_RESPONSE_STATUS_TTL_SECONDS=86400
AGENT_RESPONSE_QUEUE_ENABLED=true
AGENT_RESPONSE_STREAM=machining:agent-responses:v1
AGENT_RESPONSE_CONSUMER_GROUP=agent-response-workers-v1
AGENT_RESPONSE_STREAM_MAXLEN=10000
AGENT_RESPONSE_MAX_RETRIES=3
AGENT_RESPONSE_CLAIM_IDLE_MS=300000
AGENT_RESPONSE_REDIS_SOCKET_TIMEOUT_SECONDS=15
SUGGESTION_QUEUE_ENABLED=true
SUGGESTION_STREAM=machining:agent-suggestions:v1
SUGGESTION_CONSUMER_GROUP=agent-suggestion-workers-v1
SUGGESTION_STREAM_MAXLEN=10000
SUGGESTION_MAX_RETRIES=2
SUGGESTION_CLAIM_IDLE_MS=180000
SUGGESTION_RESPONSE_WAIT_TIMEOUT_SECONDS=180
SUGGESTION_RESPONSE_POLL_INTERVAL_SECONDS=0.2
SUGGESTION_WORKER_REPLICAS=2
SUGGESTION_WORKER_CPUS=4.0
SUGGESTION_WORKER_MEMORY_LIMIT=6g
AGENT_WORKER_REPLICAS=2
AGENT_WORKER_CPUS=4.0
AGENT_WORKER_MEMORY_LIMIT=6g
SOLIDSET_RETRY_QUEUE_ENABLED=true
SOLIDSET_RETRY_QUEUE_KEY=machining:solidset-deliveries:v1
SOLIDSET_RETRY_INTERVAL_SECONDS=300
SOLIDSET_RETRY_BATCH_SIZE=50
HISTORICAL_INGESTION_ENABLED=true
HISTORICAL_INGESTION_DRY_RUN=false
HISTORICAL_INGESTION_BATCH_SIZE=25
HISTORICAL_INGESTION_STREAM=machining:historical-ingestion:v1
HISTORICAL_INGESTION_GROUP=historical-workers-v1
HISTORICAL_INGESTION_STREAM_MAXLEN=10000
HISTORICAL_INGESTION_MAX_RETRIES=3
HISTORICAL_INGESTION_CLAIM_IDLE_MS=60000
HISTORICAL_INGESTION_STALE_SECONDS=300
HISTORICAL_INGESTION_POLL_SECONDS=120
HISTORICAL_INGESTION_ADMIN_KEY=dev-historical-admin-change-me
AGENT_USER_MEMORY_MAX_ITEMS=30
LLM_REQUEST_TIMEOUT_SECONDS=90
