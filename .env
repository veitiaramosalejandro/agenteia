# .env - Configuración para desarrollo local
ENVIRONMENT=development

# ============================================================
# OLLAMA (Modelos LLM)
# ============================================================
OLLAMA_BASE_URL=http://localhost:11435
MODEL_NAME=qwen2.5
EMBEDDING_MODEL_NAME=nomic-embed-text

# ============================================================
# QDRANT (Base de datos vectorial)
# ============================================================
VECTOR_DB_URL=http://localhost:6333
VECTOR_COLLECTION_NAME=machining_docs

# ============================================================
# REDIS (Memoria caché y estado)
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# POSTGRESQL / SQL SERVER
# ============================================================
# Si usas TimescaleDB/PostgreSQL (el de tu docker-compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=machining_db

# Si usas SQL Server (como en tu código original)
SQL_SERVER_HOST=localhost  # o la IP de tu SQL Server
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=Abcd*1234
SQL_SERVER_DB=ISIFrameIsicom

# ============================================================
# AUDIO
# ============================================================
AUDIO_DIR=./audio_samples
INGEST_INTERVAL_SECONDS=3600